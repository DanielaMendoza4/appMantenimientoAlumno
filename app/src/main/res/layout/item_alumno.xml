<?xml version="1.0" encoding="utf-8"?>
<!-- AGREGADO: layout de cada fila del RecyclerView, con nombre, teléfono, correo y botones de Editar/Eliminar -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- AGREGADO: bloque con los datos del alumno -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/tvTelefono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvCorreo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- AGREGADO: botón para editar el alumno -->
        <ImageButton
            android:id="@+id/btnEditar"
            android:layout_width="46dp"
            android:layout_height="61dp"
            android:layout_gravity="center_vertical"
            android:background="@android:color/transparent"
            android:contentDescription="Editar"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/editar" />

        <!-- AGREGADO: botón para eliminar el alumno -->
        <ImageButton
            android:id="@+id/btnEliminar"
            android:layout_width="44dp"
            android:layout_height="61dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="Eliminar"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/eliminar" />

    </LinearLayout>
</androidx.cardview.widget.CardView>